      <rd:DataSourceID>bde0ed3e-b01f-4e44-8d4c-366fecbc95b2</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ClientesActivos">
      <Query>
        <DataSourceName>CompanyManagement</DataSourceName>
        <CommandText>SELECT c.Nombre,
       c.Email,
       COUNT(o.Id) AS TotalOrdenes
FROM Clientes c
INNER JOIN Ordenes o ON o.ClienteId = c.Id
GROUP BY c.Id, c.Nombre, c.Email
ORDER BY TotalOrdenes DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Nombre</DataField>
        </Field>
        <Field Name="Email">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Email</DataField>
        </Field>
        <Field Name="TotalOrdenes">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>TotalOrdenes</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
