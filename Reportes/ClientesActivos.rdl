  <DataSources>
    <DataSource Name="CompanyManagement">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=(localdb)\mssqllocaldb;Initial Catalog=CompanyManagement</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
