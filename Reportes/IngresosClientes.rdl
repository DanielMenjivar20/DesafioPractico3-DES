  <DataSources>
    <DataSource Name="CompanyManagement">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>   Data Source=localhost\SQLEXPRESS;Initial Catalog=CompanyManagement</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>805724ec-0b77-4289-b552-96ee3da501e5</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="IngresosClientes">
      <Query>
        <DataSourceName>CompanyManagement</DataSourceName>
        <CommandText>SELECT 
    c.Nombre, 
    c.Email, 
    ISNULL(SUM(o.MontoTotal), 0) AS MontoTotal
FROM Clientes c
LEFT JOIN Ordenes o ON c.Id = o.ClienteId
GROUP BY c.Id, c.Nombre, c.Email</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Nombre</DataField>
        </Field>
        <Field Name="Email">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Email</DataField>
        </Field>
        <Field Name="MontoTotal">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>MontoTotal</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
