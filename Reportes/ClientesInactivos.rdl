  <DataSources>
    <DataSource Name="CompanyManagement">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>   Data Source=localhost\SQLEXPRESS;Initial Catalog=CompanyManagement</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>1e4e3312-3c20-4553-b2c7-89ef9402034a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ClientesInactivos">
      <Query>
        <DataSourceName>CompanyManagement</DataSourceName>
        <CommandText>   SELECT c.Nombre,
          c.Email,
          c.FechaRegistro
   FROM Clientes c
   WHERE c.FechaRegistro &gt;= DATEADD(MONTH, -1, GETUTCDATE())
     AND NOT EXISTS (SELECT 1 FROM Ordenes o WHERE o.ClienteId = c.Id)
   ORDER BY c.FechaRegistro DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Nombre</DataField>
        </Field>
        <Field Name="Email">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Email</DataField>
        </Field>
        <Field Name="FechaRegistro">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>FechaRegistro</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
